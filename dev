cmd_clean() {
  dev_compose "$DEV_PROJECT" --profile vite down --volumes --remove-orphans >/dev/null 2>&1 || true
  [[ -d .cache ]] && chmod -R u+w .cache # module caches written before -modcacherw are read-only
  rm -rf .cache web/node_modules web/dist e2e/node_modules e2e/test-results e2e/playwright-report deploy/.dev
  echo "clean"
}

cmd=${1:-help}
[[ $# -gt 0 ]] && shift
case $cmd in
  ci) cmd_ci ;;
  lint) cmd_lint ;;
  fmt) cmd_fmt ;;
  test) cmd_test "$@" ;;
  gen) cmd_gen ;;
  gen-check) cmd_gen_check ;;
  spec-verify) cmd_spec_verify ;;
  build) cmd_build ;;
  up) cmd_up "$@" ;;
  check) cmd_check ;;
  logs) cmd_logs "$@" ;;
  down) cmd_down ;;
  e2e) cmd_e2e "$@" ;;
  deps) cmd_deps ;;
  bump-mediamtx) cmd_bump_mediamtx "$@" ;;
  screenshots) cmd_screenshots ;;
  offline-clips) cmd_offline_clips ;;
  clean) cmd_clean ;;
  help | -h | --help) usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
