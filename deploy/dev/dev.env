# Non-secret settings and dev-only fixtures for the dev and e2e stacks. `./dev` passes this file with --env-file (so
# deploy/.env never leaks into them) and adds image pins, DEV_UID/DEV_GID, DATA_DIR and MTX_SUBNET per project.
# compose.yaml needs a DOMAIN; the overlays set the sidecar's URL themselves.
DOMAIN=dev.invalid
PUBLIC_URL=http://127.0.0.1:18080
PUBLIC_HOST=127.0.0.1

# Dev-only fixtures, never used by a real deployment: the stream credential of the test publisher and the dev admin
# that `./dev up` creates with `mtxui setup` (`./dev up --wizard` leaves setup to the web wizard instead).
DEV_PUBLISHER_SECRET=dev-publisher-secret-0000
DEV_ADMIN_USER=admin
DEV_ADMIN_PASSWORD=dev-admin-password
