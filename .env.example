# Copy to .env next to compose.yaml. Only DOMAIN is required.

# The domain the UI is reached at. It must point at this host with an A record (the ports are published on IPv4 only:
# README, Ports), and ports 80 and 443 must be reachable, so Let's Encrypt can check it before issuing the certificate.
DOMAIN=mtx.example.com

# Where Let's Encrypt sends certificate expiry warnings (rare: renewal is automatic). Optional.
ACME_EMAIL=

# --- Optional -----------------------------------------------------------------------------------------------------

# The sidecar image's version. A release's compose.yaml names its own, next to the MediaMTX version it was tested
# with, so upgrade by downloading the new compose.yaml (README, Upgrading). Set this only to run another build (such
# as edge), knowing that it may expect another MediaMTX.
# MTXUI_VERSION=

# The compose files every docker compose command (up, pull, exec) uses, once you add an override: your own reverse
# proxy (docs/behind-a-proxy.md), a local network only (docs/install-local.md), exposure control
# (docs/exposure-control.md). Add compose.override.yaml to the list
# too if you have one: Compose reads it by itself only while this is not set.
# COMPOSE_FILE=compose.yaml:compose.behind-proxy.yaml

# The host encoders and players connect to for streams, if not DOMAIN (e.g. a name without a proxy in front).
# STREAM_HOST=

# Storage budget for recordings in GB: the oldest recordings are deleted beyond it. 0 means none. Either way, the
# oldest are also deleted while the recordings disk has less than 20 GB free, and recording stops below 5 GB free
# (README, Recordings and free space: lower both on a small disk).
# RECORDINGS_MAX_GB=0

# Recordings and backups live in Docker volumes. To keep them on a disk of your choice instead, set absolute paths
# (the directories must belong to uid 10002: sudo install -d -o 10002 -g 10002 -m 750 /path).
# RECORDINGS_PATH=/srv/recordings
# BACKUPS_PATH=/srv/mediamtx-backups

# Let's Encrypt's staging server, for a first try without running into its rate limits (browsers will not trust the
# certificate). For the real one, remove this and run docker compose up -d again.
# ACME_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory

# Where the ports are published: on every IPv4 address of the host (0.0.0.0), or on the one address set here.
# HTTP_BIND and HTTPS_BIND are for the UI's ports, STREAM_BIND for the stream ports.
# STREAM_BIND=0.0.0.0
# The UI's ports on the host. Its address stays https://DOMAIN, so browsers and Let's Encrypt still connect to 443
# and 80: change these only when something in front (a router's port forwarding) maps those onto them. A browser
# that opens the UI on another port cannot sign in (its requests do not come from https://DOMAIN).
# HTTP_PORT=80
# HTTPS_PORT=443
# With compose.lan.yaml or compose.behind-proxy.yaml, the UI is on one plain-HTTP port instead: UI_PORT (8080), on
# UI_BIND (0.0.0.0 on a local network, 127.0.0.1 behind a proxy on this host).
# UI_PORT=8080
# UI_BIND=0.0.0.0

# Days of chart history kept (1 to 365).
# HISTORY_DAYS=30

# debug, info, warn or error.
# LOG_LEVEL=info
