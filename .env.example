# Copy to .env next to compose.yaml. Only DOMAIN is required.

# The domain the UI is reached at. It must point at this host (an A and/or AAAA record), and ports 80 and 443 must be
# reachable, so Let's Encrypt can check it before issuing the certificate.
DOMAIN=mtx.example.com

# Where Let's Encrypt sends certificate expiry warnings (rare: renewal is automatic). Optional.
ACME_EMAIL=

# --- Optional -----------------------------------------------------------------------------------------------------

# The image version; pin one (e.g. 1.0.0) to upgrade only when you choose to.
# MTXUI_VERSION=latest

# The host encoders and players connect to for streams, if not DOMAIN (e.g. a name without a proxy in front).
# STREAM_HOST=

# Storage budget for recordings in GB: the oldest recordings are deleted beyond it. 0 means none (free space limits
# still apply: docs/config.md).
# RECORDINGS_MAX_GB=0

# Recordings and backups live in Docker volumes. To keep them on a disk of your choice instead, set absolute paths
# (the directories must belong to uid 10002: sudo install -d -o 10002 -g 10002 -m 750 /path).
# RECORDINGS_PATH=/srv/recordings
# BACKUPS_PATH=/srv/mediamtx-backups

# Let's Encrypt's staging server, for a first try without running into its rate limits (browsers will not trust the
# certificate). Remove it, and the certificate in the state volume, for the real one.
# ACME_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory

# Where the ports are published. Stream ports on one address only, for example:
# STREAM_BIND=0.0.0.0
# HTTP_PORT=80
# HTTPS_PORT=443

# Days of chart history kept (1 to 365).
# HISTORY_DAYS=30

# debug, info, warn or error.
# LOG_LEVEL=info
